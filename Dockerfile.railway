# Hosted (streamable HTTP) image for Railway and similar platforms.
# The root Dockerfile stays stdio-only for registry builds.
FROM node:22-alpine

RUN apk add --no-cache su-exec

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force

COPY index.js http.js LICENSE ./
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

# Starts as root only long enough to chown the rules volume, then runs as node.
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["node", "http.js"]
