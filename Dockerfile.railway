# Hosted (streamable HTTP) image for Railway and similar platforms.
# The root Dockerfile stays stdio-only for registry builds.
FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force

COPY index.js http.js LICENSE ./

USER node

CMD ["node", "http.js"]
